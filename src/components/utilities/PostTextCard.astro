---
const { url, frontmatter } = Astro.props;
const postGenre = frontmatter.genre ? frontmatter.genre : "essay";
// const postCategory = frontmatter.category ? frontmatter.category : category;
// const categoryLink = frontmatter.category ? '#' : `/${category}/`;
---

<li class="post-card">
    <div class="card__content">
        <!-- <a href={categoryLink} class="card__category link--underline">
            {postCategory}
        </a> -->
        <div class="card__genre">
            {postGenre}
        </div>
        <a href={url} class="card__link link--no-underline">
            <div class="card__date">
                {frontmatter.pubDate}
            </div>
            <div class="card__right">
                <div class="card__title">
                    {frontmatter.title}
                </div>
                {
                    frontmatter.description && (
                        <div class="card__desc">{frontmatter.description}</div>
                    )
                }
                <div class="card__forward"></div>
            </div>
        </a>
    </div>
</li>

<style>
    .post-card {
        max-width: 100%;
        list-style: none;
        padding: 2rem 3rem 2.5rem 1rem;
        border-bottom: 1px solid;
        /* border: 3px solid; */
        /* border-bottom: 1px solid var(--text-color); */
        transition: all 0.2s ease-in-out;
    }

/*     @media (min-width: 1024px) {
        .post-card {
            padding: 2rem 3rem 3.1rem 1rem;
        }
        .post-card:nth-child(1),
        .post-card:nth-child(2) {
            padding-top: 1rem;
        }

        .post-card:nth-child(odd) {
            border-right: 1px solid;
        }

        .post-card:nth-child(even) {
            padding-left: 2rem;
        }
    }

    @media (max-width: 1024px) {
        .post-card {
            max-width: 100%;
            width: 100%;
            margin-top: 2rem;
        }
    } */

    .card__content {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        max-width: 100%;
        width: 100%;
        height: 100%;
    }

    .card__genre {
        margin-left: 11.05em;
        margin-bottom: 0.7rem;
        text-transform: uppercase;
        font-weight: 500;
        width: max-content;
    }

    .card__link {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        gap: 3rem;
        align-items: flex-start;
    }

    .card__link:hover .card__title {
        text-decoration: underline;
    }

    .card__right {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.6rem;
    }

    .card__date {
        width: 8rem;
        margin-top: 0.3em;
        font-family: 'Literata', serif;
    }

    .card__title {
        font-size: 2.2rem;
        font-family: "Belarus";
        text-transform: uppercase;
        transition: all 0.2s ease-in-out;
    }

    /*     .card__link:hover .card__title {
        color: var(--text-color2);
    } */

    .card__desc {
        max-width: 100%;
        text-align: justify;
        padding-right: 4rem;
        line-height: 1.6;
        transition: all 0.2s ease-in-out;
    }

    .card__img {
        position: absolute;
        top: -0.5rem;
        right: -5rem;
        display: block;
        max-height: 120%;
        transform: translateX(100%);
    }

    .card__forward {
        position: absolute;
        bottom: 50%;
        right: 0;
        width: 2.7rem;
        height: 2.7rem;
        background-image: url(../../assets/icons/arrow_forward.svg);
        background-size: 75%;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 0;
        transform: translateY(50%);
        transition: all 0.2s ease-in-out;
    }

    .card__link:hover .card__forward {
        opacity: 1;
        transform: translateX(25%) translateY(50%);
    }
</style>

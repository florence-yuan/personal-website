---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/utilities/PostList.astro";

const pageTitle = "Writing Portfolio";
---

<BaseLayout pageTitle={pageTitle} hasBg={true}>
	<section class="section--blog">
		<h1 class="section__title">The Curiosity Shop</h1>
		<p>My writing portfolio.</p>

		<PostList category="all" />
	</section>
</BaseLayout>

<style>
	body::before,
	body::after {
		content: "";
		position: fixed;
	}
	body::before {
		/* content: "";
		position: fixed; */
		top: -10rem;
		left: -5rem;
		width: calc(100% + 10rem);
		max-width: 100rem;
		height: 100%;
		background-image:
			radial-gradient(circle at 15% 12%, rgba(255, 0, 0, 0.55) 3rem, transparent 70rem),
			url(../assets/images/noise.svg)
			;
		background-size: 100%, 20%;
		filter: brightness(2) contrast(2);
		mix-blend-mode: screen;
		/* filter: blur(50px); */
		z-index: -1;
	}

	body::after {
		top: 0rem;
		left: 0rem;
		width: calc(100% + 10rem);
		max-width: 100rem;
		height: 100%;
		background-image:
			radial-gradient(circle at 30% 30%, rgba(0, 60, 255, 0.55) 3rem, transparent 30rem),
			url(../assets/images/noise.svg)
			;
		background-size: 100%, 20%;
		filter: brightness(2) contrast(2);
		mix-blend-mode: screen;
		/* filter: blur(50px); */
		z-index: -1;
	}

	.section__title {
		font-size: 10rem;
		font-weight: normal;
		margin-top: 8rem;
		margin-left: 6vw;
		line-height: 1.2;
	}

	p {
		margin-left: calc(6vw + 0.5em);
		font-family: "Literata", serif;
		font-size: 1.3rem;
		font-weight: 300;
	}
</style>
